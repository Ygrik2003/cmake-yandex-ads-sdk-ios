{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 2
  },
  "configurePresets": [
    {
      "name": "xcode-ios",
      "displayName": "Using Xcode generator to build for iOS",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/.build/${presetName}",
      "toolchainFile": "${sourceDir}/ios.toolchain.cmake"
    },
    {
      "name": "xcode-ios-cocoa",
      "displayName": "Using Xcode generator to build for iOS via CocoaPods",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/.build/${presetName}",
      "toolchainFile": "${sourceDir}/ios.toolchain.cmake",
      "cacheVariables": {
        "TP_REBUILD_COCOAPODS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "xcode-ios",
      "configurePreset": "xcode-ios",
      "targets": [
        "default"
      ]
    },
    {
      "name": "xcode-ios-cocoa",
      "configurePreset": "xcode-ios-cocoa",
      "targets": [
        "default"
      ]
    }
  ]
}